# Copy to .env and fill in. Never commit .env.

# --- Postgres (local dev via docker-compose) ---
POSTGRES_USER=clothist
POSTGRES_PASSWORD=clothist_dev
POSTGRES_DB=clothist
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Host-side port mapping for docker-compose. Change if 5433 is also taken.
POSTGRES_HOST_PORT=5433

# DATABASE_URL is what the API actually reads.
# For local docker-compose:
DATABASE_URL=postgresql+asyncpg://clothist:clothist_dev@localhost:5433/clothist

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Scraper ---
SCRAPER_USER_AGENT=ClothistBot/0.1 (+https://example.com)
SCRAPER_REQUEST_TIMEOUT=20
SCRAPER_RATE_LIMIT_SECONDS=1.5

# --- LLM provider (OpenAI-compatible — default: Google Gemini) ---
# Default: Gemini 2.0 Flash via Google's OpenAI-compatible endpoint.
# Get a free key at https://aistudio.google.com/ (no card required;
# 1M tokens/day on the free tier as of early 2026).
#
# To swap providers, change LLM_BASE_URL + LLM_MODEL. Examples:
#   Groq:     LLM_BASE_URL=https://api.groq.com/openai/v1     LLM_MODEL=llama-3.3-70b-versatile
#   Cerebras: LLM_BASE_URL=https://api.cerebras.ai/v1         LLM_MODEL=llama3.3-70b
#   OpenAI:   LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o-mini
#
# If LLM_API_KEY is unset, /search/intent returns 503 and the frontend
# falls back to plain keyword search.
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_TIMEOUT_SECONDS=12

# --- Supabase (filled in once you create a project; ignored locally) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
